PORT=8787
GEMINI_API_KEY=PASTE_YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-3.8-flash
GEMINI_ROUTE_MODEL=gemini-3.1-flash-lite
# Shared with the iOS app (Authorization: Bearer …). Required for POST /v1/analyze.
SAFESIGHT_API_SECRET=PASTE_A_LONG_RANDOM_SECRET_HERE
# Optional soft cap per client IP (default 40/hour).
# SAFESIGHT_RATE_LIMIT_PER_HOUR=40

# Supabase (server-only — never ship secret key to iOS)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
# JWT verification for Supabase Auth access tokens (user login)
SUPABASE_JWKS_URL=https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json

# Resend — OTP emails (server sends codes; Supabase still issues JWTs)
RESEND_API_KEY=re_...
RESEND_FROM=Safesight <noreply@safesight.app>
# Logo in OTP emails: {SAFESIGHT_PUBLIC_ORIGIN}/logo.png (serve public/logo.png)
SAFESIGHT_PUBLIC_ORIGIN=https://safesight.noahwhiteson.com

# RevenueCat secret API key — required for server-verified premium (subscription-sync).
# Dashboard → Project → API keys → Secret API key. Entitlement id must match iOS (default safesight_pro).
REVENUECAT_SECRET_API_KEY=
# REVENUECAT_ENTITLEMENT_ID=safesight_pro
